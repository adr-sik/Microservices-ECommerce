{
  "ConnectionStrings": {
    "Database": "Host=localhost;Database=user_service;Username=postgres;Password=postgres"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Otel": {
    "CollectorEndpoint": "http://localhost:4317"
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "testIssuer",
    "Audience": "testAudience"
  }
}
