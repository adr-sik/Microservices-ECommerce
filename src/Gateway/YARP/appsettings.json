        "Transforms": [
          { "PathRemovePrefix": "/user" }
        ]
      },
      "catalog-service-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/catalog/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/catalog" }
        ]
      },
      "ordering-service-route": {
        "ClusterId": "ordering-cluster",
        "Match": {
          "Path": "/ordering/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/ordering" }
        ]
      },
      "catalog-json-proxy": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/openapi/catalog.json" },
        "Transforms": [ { "PathPattern": "/openapi/v1.json" } ]
      },
      "user-json-proxy": {
        "ClusterId": "user-cluster",
        "Match": { "Path": "/openapi/user.json" },
        "Transforms": [ { "PathPattern": "/openapi/v1.json" } ]
      },
      "ordering-json-proxy": {
        "ClusterId": "ordering-cluster",
        "Match": { "Path": "/openapi/ordering.json" },
        "Transforms": [ { "PathPattern": "/openapi/v1.json" } ]
      },
      "inventory-json-proxy": {
        "ClusterId": "inventory-cluster",
        "Match": { "Path": "/openapi/inventory.json" },
        "Transforms": [ { "PathPattern": "/openapi/v1.json" } ]
      }
    }
  }
