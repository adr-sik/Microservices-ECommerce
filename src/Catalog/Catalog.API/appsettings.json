{
  "CatalogDatabase": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "CatalogDb",
    "ProductsCollectionName": "Products",
    "ComponentsCollectionName": "Components"
  },
  "Serilog": {
    "MinimumLevel": {
